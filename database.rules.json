{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || (data.child('host').val() === auth.uid && !newData.exists()))",
        "status": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid"
        },
        "round": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid"
        },
        "seats": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid",
          "$color": {
            ".write": "auth != null && (data.child('uid').val() === auth.uid || (data.child('type').val() === 'open' && newData.child('type').val() === 'human' && newData.child('uid').val() === auth.uid))"
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "actions": {
          "$round": {
            "$n": {
              ".write": "auth != null && !data.exists() && root.child('rooms').child($code).child('status').val() === 'playing'",
              ".validate": "newData.hasChildren(['t'])"
            }
          }
        }
      }
    }
  }
}
